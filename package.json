{
  "name": "oniko-plugin",
  "version": "2.7",
  "description": "The oNiko extension is designed for browsers based on Chromium and Firefox.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build-chromium": " cpy manifest_chromium.json dist --rename=manifest.json && webpack --mode production",
    "build-firefox": " cpy manifest_firefox.json dist --rename=manifest.json && webpack --mode production",
    "watch-chromium": " cpy manifest_chromium.json dist --rename=manifest.json && webpack --mode development --watch",
    "watch-firefox": "cpy manifest_firefox.json dist --rename=manifest.json && webpack --mode development --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazelik-null/ONiko-plugin.git"
  },
